{
    "name": "@bric/rex-page-events",
    "version": "0.0.1",
    "description": "REX module that records page, tab, and window lifecycle events with optional URL redaction via rex-lists.",
    "keywords": [
        "extension",
        "rex"
    ],
    "author": "Behavioral Research Innovation Center",
    "type": "module",
    "homepage": "https://github.com/bric-digital/rex-page-events",
    "bugs": {
        "url": "https://github.com/bric-digital/rex-page-events/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bric-digital/rex-page-events.git"
    },
    "exports": {
        "./browser": "./src/browser.mts",
        "./service-worker": "./src/service-worker.mts"
    },
    "scripts": {
        "build": "tsc",
        "lint": "eslint src",
        "pretest": "node tests/scripts/build-test-bundle.js && node tests/extended/scripts/build-test-bundle.js",
        "test": "playwright test",
        "test:ci": "npm run pretest && playwright test --reporter=dot",
        "test:debug": "playwright test --debug",
        "test:headed": "playwright test --headed",
        "test:ui": "playwright test --ui",
        "test:unit": "playwright test specs/",
        "server": "node tests/scripts/run-server.js"
    },
    "dependencies": {
        "@bric/rex-core": "github:bric-digital/rex-core#e7cd111aad3dd5bd2e103414c3488f8169d2b0d1",
        "@bric/rex-lists": "github:bric-digital/rex-lists#f4beb8b51bb972d01dde261f91bd49e0f06e6424",
        "@bric/rex-types": "github:bric-digital/rex-types#76cbb61ce09be3a6d79d1b329a8f64c9ab505ef6"
    },
    "devDependencies": {
        "@playwright/test": "1.65.0",
        "express": "^5.3.0"
    }
}
